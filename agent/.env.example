# Groq LLM API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth (Optional fallback for desktop CLI mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# Service-to-Service Security Secret (Shared with Node.js backend)
AGENT_SERVICE_SECRET=REPLACE_ME_WITH_A_SECURE_SECRET
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
