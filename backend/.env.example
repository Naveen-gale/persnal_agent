# ==========================================
# Personal AI Agent - Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000

# MongoDB Atlas / Database Connection
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/personal_agent
MONGODB_DB_NAME=personal_agent

# JWT / Session Secret (Min 32 random characters for HMAC-SHA256)
SESSION_SECRET=dev_jwt_secret_change_in_production_min32chars
COOKIE_NAME=agent_token
SESSION_MAX_AGE_MS=604800000

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# AES-256-GCM Token Encryption Key (Exactly 32 ASCII characters or 64 hex characters)
# Generate securely via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=dev_encryption_key_change_in_production_32b

# Python Agent Service (Internal or Service-to-Service URL & Pre-Shared Secret)
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_SERVICE_SECRET=local_dev_agent_secret_32bytes_min

# Optional: Bootstrap Initial Owner Account on First Run
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
